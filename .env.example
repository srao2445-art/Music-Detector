PORT=3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Configure Resend to deliver password-reset OTP emails.
# Create an API key at https://resend.com and verify your sending domain before production use.
RESEND_API_KEY=
EMAIL_FROM="The Creator Studio <onboarding@resend.dev>"
# Keep false in production. When true and email is not configured, reset OTPs print to the server console.
DEV_SHOW_OTP=true
