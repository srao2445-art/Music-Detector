<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="<%= settings.tagline %>"><title><%= title ? `${title} — ${settings.site_name}` : settings.site_name %></title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/"><span class="brand-mark">✦</span><span><%= settings.site_name %></span></a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">☰</button><nav class="main-nav"><a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a><a class="<%= currentPath.startsWith('/projects') ? 'active' : '' %>" href="/projects">Projects</a><a class="<%= currentPath === '/services' ? 'active' : '' %>" href="/services">Services</a><a class="<%= currentPath === '/about' ? 'active' : '' %>" href="/about">About</a><a class="nav-cta" href="/contact">Let's talk <span>↗</span></a></nav></div></header>
<main><% if (notice) { %><div class="container"><div class="notice <%= notice.type %>"><%= notice.message %></div></div><% } %>
