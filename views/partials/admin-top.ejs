<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> — Studio Admin</title><link rel="stylesheet" href="/css/style.css"></head><body class="admin-body"><aside class="admin-sidebar"><a class="brand" href="/admin/dashboard"><span class="brand-mark">✦</span><span>Creator Studio</span></a><nav><a class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>" href="/admin/dashboard"><span>⌂</span>Overview</a><a class="<%= currentPath.startsWith('/admin/projects') ? 'active' : '' %>" href="/admin/projects"><span>◇</span>Projects</a><a class="<%= currentPath.startsWith('/admin/services') ? 'active' : '' %>" href="/admin/services"><span>✦</span>Services</a><a class="<%= currentPath.startsWith('/admin/pages') ? 'active' : '' %>" href="/admin/pages"><span>☷</span>Pages</a><a class="<%= currentPath === '/admin/settings' ? 'active' : '' %>" href="/admin/settings"><span>⚙</span>Site settings</a><a class="<%= currentPath.includes('/security') ? 'active' : '' %>" href="/admin/settings/security"><span>♙</span>Security</a></nav><div class="sidebar-bottom"><a href="/" target="_blank">↗ View website</a><form method="post" action="/admin/logout"><button>← Log out</button></form></div></aside><div class="admin-shell"><header class="admin-header"><button class="admin-menu menu-toggle" aria-label="Toggle sidebar">☰</button><div><small>THE CREATOR STUDIO</small><h1><%= title %></h1></div><div class="admin-user"><span><%= admin.email.charAt(0).toUpperCase() %></span><div><b>Administrator</b><small><%= admin.email %></small></div></div></header><main class="admin-main"><% if (notice) { %><div class="notice <%= notice.type %>"><%= notice.message %></div><% } %>
