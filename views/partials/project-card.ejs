<article class="project-card glass-card"><a class="project-media" href="/projects/<%= project.slug %>"><% if (project.thumbnail) { %><img src="<%= project.thumbnail %>" alt="<%= project.title %>"><% } else { %><span class="media-placeholder"><span>✦</span></span><% } %><span class="status status-<%= project.status %>"><%= project.status %></span></a><div class="project-body"><div class="eyebrow"><%= project.category %></div><h3><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3><p><%= project.short_description %></p><div class="card-bottom"><div class="tags"><% splitList(project.tags).slice(0, 3).forEach(tag => { %><span><%= tag %></span><% }) %></div><a class="round-link" href="/projects/<%= project.slug %>" aria-label="View <%= project.title %>">↗</a></div></div></article>
