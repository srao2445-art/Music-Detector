<%- include('../partials/header', { title: '' }) %>
<section class="hero"><div class="hero-glow"></div><div class="container hero-grid"><div><div class="pill"><i></i> Independent digital studio</div><h1><%= settings.hero_title %></h1><p class="hero-copy"><%= settings.hero_intro %></p><div class="hero-actions"><a class="btn primary" href="<%= settings.hero_primary_link %>"><%= settings.hero_primary_text %> <span>↗</span></a><a class="btn secondary" href="<%= settings.hero_secondary_link %>"><%= settings.hero_secondary_text %></a></div><div class="hero-stats"><div><strong><%= projects.length %>+</strong><span>Featured builds</span></div><div><strong><%= services.length %></strong><span>Studio services</span></div><div><strong>100%</strong><span>Built with care</span></div></div></div><div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-card card-a"><span>✦</span><small>CRAFT</small><b>Digital experiences</b></div><div class="floating-card card-b"><small>FOCUS</small><b>Design · Build · Launch</b></div><div class="art-core">CS</div></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Selected work</span><h2>Projects with purpose.</h2></div><a class="text-link" href="/projects">View all projects <span>↗</span></a></div><div class="cards-grid"><% projects.forEach(project => { %><%- include('../partials/project-card', { project }) %><% }) %></div></div></section>
<section class="section services-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">What I do</span><h2>From first sketch to final launch.</h2></div><a class="text-link" href="/services">Explore services <span>↗</span></a></div><div class="services-grid"><% services.forEach(service => { %><%- include('../partials/service-card', { service }) %><% }) %></div></div></section>
<section class="section"><div class="container cta-panel"><span class="eyebrow">Have an idea?</span><h2>Let’s make something<br>people remember.</h2><p><%= page.content %></p><a class="btn primary" href="/contact">Start a conversation <span>↗</span></a></div></section>
<%- include('../partials/footer') %>
