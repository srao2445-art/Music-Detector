<%- include('../partials/header', { title: 'Contact' }) %><section class="page-hero"><div class="container"><span class="eyebrow">Contact</span><h1>Let’s create something<br><em>worth sharing.</em></h1><p><%= page.content %></p></div></section><section class="section compact"><div class="container contact-grid"><div class="contact-panel glass-card"><h2>Connect directly</h2><a class="contact-item" href="mailto:<%= extras(page).email %>"><span>✉</span><div><small>EMAIL</small><b><%= extras(page).email %></b></div></a><% if (extras(page).whatsapp) { %><a class="contact-item" href="<%= extras(page).whatsapp %>"><span>◉</span><div><small>WHATSAPP</small><b>Send a message</b></div></a><% } %><% parseSocials(extras(page).social_links).forEach(social => { %><a class="contact-item" href="<%= social[1] %>" target="_blank" rel="noopener"><span>↗</span><div><small>SOCIAL</small><b><%= social[0] %></b></div></a><% }) %></div><form class="contact-form glass-card" method="post"><div class="form-row"><label>Your name<input required name="name" placeholder="Jane Smith"></label><label>Email address<input required type="email" name="email" placeholder="jane@example.com"></label></div><label>Subject<input required name="subject" placeholder="What would you like to build?"></label><label>Tell me about your idea<textarea required name="message" rows="6" placeholder="Share the details, goals, or questions you have..."></textarea></label><button class="btn primary">Send inquiry ↗</button><small>This form does not store messages. Use the email link to send your inquiry directly.</small></form></div></section><%- include('../partials/footer') %>
