<%- include('../partials/header', { title: 'Projects' }) %><section class="page-hero"><div class="container"><span class="eyebrow">Portfolio</span><h1>Projects built to make<br><em>an impact.</em></h1><p>Browse websites, tools, apps, and experiments from the studio.</p></div></section><section class="section compact"><div class="container"><form class="filter-bar" method="get"><label><span>⌕</span><input name="search" value="<%= search %>" placeholder="Search projects"></label><select name="category"><option value="">All categories</option><% categories.forEach(item => { %><option <%= item === category ? 'selected' : '' %>><%= item %></option><% }) %></select><button class="btn primary small">Filter</button></form><div class="cards-grid"><% projects.forEach(project => { %><%- include('../partials/project-card', { project }) %><% }) %></div><% if (!projects.length) { %><div class="empty-state">No projects matched your search. Try another filter.</div><% } %></div></section><%- include('../partials/footer') %>
