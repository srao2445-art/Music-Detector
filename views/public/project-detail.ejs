<%- include('../partials/header', { title: project.title }) %><section class="project-hero"><div class="container"><a class="back-link" href="/projects">← Back to projects</a><div class="detail-grid"><div><span class="eyebrow"><%= project.category %> · <%= project.status %></span><h1><%= project.title %></h1><p><%= project.short_description %></p><div class="hero-actions"><% if (project.live_link) { %><a class="btn primary" href="<%= project.live_link %>" target="_blank" rel="noopener">View live project ↗</a><% } %><% if (project.source_link) { %><a class="btn secondary" href="<%= project.source_link %>" target="_blank" rel="noopener">Source code</a><% } %></div></div><div class="detail-media"><% if (project.thumbnail) { %><img src="<%= project.thumbnail %>" alt="<%= project.title %>"><% } else { %><span>✦</span><% } %></div></div></div></section><section class="section compact"><div class="container content-grid"><div><span class="eyebrow">Overview</span><h2>About this project</h2><p class="long-copy"><%= project.description %></p><% if (splitList(project.gallery).length) { %><div class="gallery"><% splitList(project.gallery).forEach(image => { %><img src="<%= image %>" alt="<%= project.title %> screenshot"><% }) %></div><% } %></div><aside class="project-aside glass-card"><div><small>FEATURES</small><ul><% splitList(project.features).forEach(item => { %><li><span>✓</span><%= item %></li><% }) %></ul></div><div><small>TECH STACK</small><div class="tags"><% splitList(project.tech_stack).forEach(item => { %><span><%= item %></span><% }) %></div></div></aside></div></section><%- include('../partials/footer') %>
