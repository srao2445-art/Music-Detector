<%- include('../partials/admin-top', { title: service ? 'Edit service' : 'Add service' }) %><a class="back-link" href="/admin/services">← Back to services</a><form class="admin-form" method="post" enctype="multipart/form-data" action="<%= service ? `/admin/services/${service.id}` : '/admin/services' %>"><section class="admin-panel"><div class="panel-heading"><div><h3>Service details</h3><p>Describe the value your service provides.</p></div></div><div class="form-grid"><label>Title<input required name="title" value="<%= service?.title || '' %>"></label><label>Price text <small>optional</small><input name="price_text" value="<%= service?.price_text || '' %>" placeholder="From $500 or Custom quote"></label><label class="wide">Description<textarea required name="description" rows="5"><%= service?.description || '' %></textarea></label><label>CTA text<input name="cta_text" value="<%= service?.cta_text || '' %>" placeholder="Let's talk"></label><label>CTA link<input name="cta_link" value="<%= service?.cta_link || '/contact' %>"></label><label>Image or icon<input type="file" name="image" accept="image/*"><% if (service?.image) { %><img class="upload-preview" src="<%= service.image %>" alt=""><% } %></label><label class="check"><input type="checkbox" name="featured" <%= service?.featured ? 'checked' : '' %>> Feature on homepage</label></div></section><button class="btn primary"><%= service ? 'Save changes' : 'Create service' %> ↗</button></form><%- include('../partials/admin-bottom') %>
