<%- include('../partials/admin-top', { title: 'Projects' }) %><section class="panel-heading top-actions"><div><h2>Portfolio projects</h2><p>Add, update, or archive your work.</p></div><a class="btn primary" href="/admin/projects/new">+ Add project</a></section><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Project</th><th>Category</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% projects.forEach(project => { %><tr><td><div class="table-project"><div><% if (project.thumbnail) { %><img src="<%= project.thumbnail %>" alt=""><% } else { %>✦<% } %></div><b><%= project.title %></b></div></td><td><%= project.category %></td><td><span class="status status-<%= project.status %>"><%= project.status %></span></td><td><%= project.featured ? 'Yes' : 'No' %></td><td><div class="action-row"><a href="/admin/projects/<%= project.id %>/edit">Edit</a><form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete this project?')"><button class="danger-link">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-bottom') %>
