<%- include('../partials/admin-top', { title: 'Services' }) %><section class="panel-heading top-actions"><div><h2>Studio services</h2><p>Keep your offers clear and up to date.</p></div><a class="btn primary" href="/admin/services/new">+ Add service</a></section><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Service</th><th>Price text</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% services.forEach(service => { %><tr><td><b><%= service.title %></b></td><td><%= service.price_text %></td><td><%= service.featured ? 'Yes' : 'No' %></td><td><div class="action-row"><a href="/admin/services/<%= service.id %>/edit">Edit</a><form method="post" action="/admin/services/<%= service.id %>/delete" onsubmit="return confirm('Delete this service?')"><button class="danger-link">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-bottom') %>
