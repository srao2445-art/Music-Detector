<%- include('../partials/admin-top', { title: `Edit ${page.slug} page` }) %><a class="back-link" href="/admin/pages">← Back to pages</a><form class="admin-form" method="post" enctype="multipart/form-data" action="/admin/pages/<%= page.slug %>"><section class="admin-panel"><div class="panel-heading"><div><h3><%= page.title %></h3><p>Edit the content shown on your public <%= page.slug %> page.</p></div></div><div class="form-grid"><label class="wide">Page heading<input required name="title" value="<%= page.title %>"></label><label class="wide">Page content<textarea name="content" rows="6"><%= page.content %></textarea></label><% if (page.slug === 'about') { %><label>Skills<textarea name="skills" rows="4"><%= pageExtras.skills || '' %></textarea></label><label>Tools<textarea name="tools" rows="4"><%= pageExtras.tools || '' %></textarea></label><label>Profile image<input type="file" name="image" accept="image/*"><% if (pageExtras.image) { %><img class="upload-preview" src="<%= pageExtras.image %>" alt=""><% } %></label><% } %><% if (page.slug === 'contact') { %><p class="wide">Contact email, WhatsApp, and social links are managed under <a class="text-link" href="/admin/settings">Site settings →</a></p><% } %></div></section><button class="btn primary">Save page ↗</button></form><%- include('../partials/admin-bottom') %>
