<%- include('../partials/admin-top', { title: `Edit ${page.slug} page` }) %><a class="back-link" href="/admin/pages">← Back to pages</a><form class="admin-form" method="post" enctype="multipart/form-data" action="/admin/pages/<%= page.slug %>"><section class="admin-panel"><div class="panel-heading"><div><h3><%= page.title %></h3><p>Edit the content shown on your public <%= page.slug %> page.</p></div></div><div class="form-grid"><label class="wide">Page heading<input required name="title" value="<%= page.title %>"></label><label class="wide">Page content<textarea name="content" rows="6"><%= page.content %></textarea></label><% if (page.slug === 'about') { %><label>Skills<textarea name="skills" rows="4"><%= pageExtras.skills || '' %></textarea></label><label>Tools<textarea name="tools" rows="4"><%= pageExtras.tools || '' %></textarea></label><label>Profile image<input type="file" name="image" accept="image/*"><% if (pageExtras.image) { %><img class="upload-preview" src="<%= pageExtras.image %>" alt=""><% } %></label><% } %><% if (page.slug === 'contact') { %><label>Email address<input type="email" name="email" value="<%= pageExtras.email || '' %>"></label><label>WhatsApp URL <small>optional</small><input name="whatsapp" value="<%= pageExtras.whatsapp || '' %>" placeholder="https://wa.me/..."></label><label class="wide">Social links <small>one per line: Label|URL</small><textarea name="social_links" rows="5"><%= pageExtras.social_links || '' %></textarea></label><% } %></div></section><button class="btn primary">Save page ↗</button></form><%- include('../partials/admin-bottom') %>
