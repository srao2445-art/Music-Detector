<%- include('../partials/admin-top', { title: 'Site settings' }) %><form class="admin-form" method="post" action="/admin/settings"><section class="admin-panel"><div class="panel-heading"><div><h3>Global site settings</h3><p>Manage your brand, homepage hero, contact details, footer, and SEO metadata.</p></div></div><div class="form-grid"><label>Site name<input required name="site_name" value="<%= settings.site_name %>"></label><label>Tagline<input required name="tagline" value="<%= settings.tagline %>"></label><label class="wide">Hero title<input required name="hero_title" value="<%= settings.hero_title %>"></label><label class="wide">Hero intro<textarea required rows="3" name="hero_intro"><%= settings.hero_intro %></textarea></label><label>Primary CTA text<input required name="hero_primary_text" value="<%= settings.hero_primary_text %>"></label><label>Primary CTA link<input required name="hero_primary_link" value="<%= settings.hero_primary_link %>"></label><label>Secondary CTA text<input required name="hero_secondary_text" value="<%= settings.hero_secondary_text %>"></label><label>Secondary CTA link<input required name="hero_secondary_link" value="<%= settings.hero_secondary_link %>"></label><label>Email<input required type="email" name="email" value="<%= settings.email %>"></label><label>WhatsApp URL <small>optional</small><input name="whatsapp" value="<%= settings.whatsapp %>" placeholder="https://wa.me/..."></label><label class="wide">Social links <small>one per line: Label|URL</small><textarea name="social_links" rows="4"><%= settings.social_links %></textarea></label><label class="wide">Footer text<input required name="footer_text" value="<%= settings.footer_text %>"></label><label class="wide">SEO title<input required name="seo_title" value="<%= settings.seo_title %>"></label><label class="wide">SEO description<textarea required name="seo_description" rows="3"><%= settings.seo_description %></textarea></label></div></section><button class="btn primary">Save site settings ↗</button></form><%- include('../partials/admin-bottom') %>
