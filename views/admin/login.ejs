<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Studio login — The Creator Studio</title><link rel="stylesheet" href="/css/style.css"></head><body class="login-page"><div class="login-glow"></div><main class="login-card glass-card"><a class="brand" href="/"><span class="brand-mark">✦</span><span>The Creator Studio</span></a><div><span class="eyebrow">Private studio</span><h1>Welcome back.</h1><p>Sign in to manage your portfolio content.</p></div><% if (notice) { %><div class="notice <%= notice.type %>"><%= notice.message %></div><% } %><% if (currentPath && false) { %><% } %><form method="post" action="/admin/login"><label>Email address<input type="email" required name="email" autocomplete="username" placeholder="you@example.com"></label><label>Password<input type="password" required name="password" autocomplete="current-password" placeholder="••••••••"></label><button class="btn primary">Sign in to dashboard ↗</button></form><a class="back-link" href="/">← Back to website</a></main></body></html>
