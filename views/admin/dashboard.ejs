<%- include('../partials/admin-top', { title: 'Overview' }) %><section class="admin-welcome"><div><span class="eyebrow">Dashboard</span><h2>Welcome back to your studio.</h2><p>Manage your content, keep your projects fresh, and shape your online presence.</p></div><a class="btn primary" href="/admin/projects/new">+ Add new project</a></section><section class="stat-grid"><div><span>◇</span><b><%= counts.projects %></b><small>Projects</small></div><div><span>✦</span><b><%= counts.services %></b><small>Services</small></div><div><span>☷</span><b><%= counts.pages %></b><small>Editable pages</small></div><div><span>▧</span><b><%= counts.uploads %></b><small>Uploads</small></div></section><section class="admin-panel"><div class="panel-heading"><div><h3>Recent projects</h3><p>Your latest portfolio content.</p></div><a class="text-link" href="/admin/projects">Manage all →</a></div><div class="table-wrap"><table><thead><tr><th>Project</th><th>Category</th><th>Status</th><th>Featured</th><th></th></tr></thead><tbody><% recentProjects.forEach(project => { %><tr><td><b><%= project.title %></b></td><td><%= project.category %></td><td><span class="status status-<%= project.status %>"><%= project.status %></span></td><td><%= project.featured ? 'Yes' : 'No' %></td><td><a href="/admin/projects/<%= project.id %>/edit">Edit →</a></td></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-bottom') %>
