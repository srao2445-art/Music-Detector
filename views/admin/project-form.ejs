<%- include('../partials/admin-top', { title: project ? 'Edit project' : 'Add project' }) %><a class="back-link" href="/admin/projects">← Back to projects</a><form class="admin-form" method="post" enctype="multipart/form-data" action="<%= project ? `/admin/projects/${project.id}` : '/admin/projects' %>"><section class="admin-panel"><div class="panel-heading"><div><h3>Project essentials</h3><p>Core details shown across your website.</p></div></div><div class="form-grid"><label>Project title<input required name="title" value="<%= project?.title || '' %>"></label><label>URL slug<input name="slug" value="<%= project?.slug || '' %>" placeholder="generated-from-title"></label><label>Category<input required name="category" value="<%= project?.category || '' %>" placeholder="Website, App, Tool..."></label><label>Status<select name="status"><% ['active','beta','archived'].forEach(item => { %><option <%= project?.status === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label><label class="wide">Short description<textarea required name="short_description" rows="2"><%= project?.short_description || '' %></textarea></label><label class="wide">Full description<textarea name="description" rows="5"><%= project?.description || '' %></textarea></label><label>Live link<input name="live_link" value="<%= project?.live_link || '' %>" placeholder="https://..."></label><label>Source link <small>optional</small><input name="source_link" value="<%= project?.source_link || '' %>" placeholder="https://..."></label><label class="wide check"><input type="checkbox" name="featured" <%= project?.featured ? 'checked' : '' %>> Feature this project on the homepage</label></div></section><section class="admin-panel"><div class="panel-heading"><div><h3>Details & media</h3><p>Use commas, new lines, or | separators for lists.</p></div></div><div class="form-grid"><label>Tags<textarea name="tags" rows="3"><%= project?.tags || '' %></textarea></label><label>Tech stack<textarea name="tech_stack" rows="3"><%= project?.tech_stack || '' %></textarea></label><label class="wide">Features<textarea name="features" rows="4"><%= project?.features || '' %></textarea></label><label>Thumbnail image<input type="file" name="thumbnail" accept="image/*"><% if (project?.thumbnail) { %><img class="upload-preview" src="<%= project.thumbnail %>" alt=""><% } %></label><label>Gallery images <small>up to 8</small><input type="file" multiple name="gallery" accept="image/*"><% if (project && splitList(project.gallery).length) { %><span><%= splitList(project.gallery).length %> image(s) uploaded</span><label class="check"><input type="checkbox" name="clear_gallery"> Replace existing gallery</label><% } %></label></div></section><button class="btn primary"><%= project ? 'Save changes' : 'Create project' %> ↗</button></form><%- include('../partials/admin-bottom') %>
