<%- include('../partials/admin-top', { title: 'Security' }) %><section class="admin-panel security-panel"><div class="panel-heading"><div><h3>Change password</h3><p>Use a strong password you do not reuse anywhere else. You will be logged out after saving.</p></div></div><form class="admin-form" method="post" action="/api/admin/change-password"><label>Current password<input required type="password" name="current_password" autocomplete="current-password"></label><label>New password<input required minlength="8" type="password" name="new_password" autocomplete="new-password"></label><label>Confirm new password<input required minlength="8" type="password" name="confirm_password" autocomplete="new-password"></label><button class="btn primary">Update password ↗</button></form></section><%- include('../partials/admin-bottom') %>
