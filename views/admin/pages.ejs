<%- include('../partials/admin-top', { title: 'Pages & site' }) %><section class="admin-panel"><div class="panel-heading"><div><h3>Editable pages</h3><p>Update the written content and contact details.</p></div></div><div class="page-list"><% pages.forEach(page => { %><a href="/admin/pages/<%= page.slug %>/edit"><span>☷</span><div><b><%= page.title %></b><small>/<%= page.slug %></small></div><em>Edit →</em></a><% }) %></div></section><form class="admin-form" method="post" action="/admin/settings"><section class="admin-panel"><div class="panel-heading"><div><h3>Global site settings</h3><p>Brand, hero, and footer content.</p></div></div><div class="form-grid"><label>Site name<input required name="site_name" value="<%= siteSettings.site_name %>"></label><label>Tagline<input required name="tagline" value="<%= siteSettings.tagline %>"></label><label class="wide">Hero title<input required name="hero_title" value="<%= siteSettings.hero_title %>"></label><label class="wide">Hero intro<textarea required rows="3" name="hero_intro"><%= siteSettings.hero_intro %></textarea></label><label>Primary CTA text<input required name="hero_primary_text" value="<%= siteSettings.hero_primary_text %>"></label><label>Primary CTA link<input required name="hero_primary_link" value="<%= siteSettings.hero_primary_link %>"></label><label>Secondary CTA text<input required name="hero_secondary_text" value="<%= siteSettings.hero_secondary_text %>"></label><label>Secondary CTA link<input required name="hero_secondary_link" value="<%= siteSettings.hero_secondary_link %>"></label><label class="wide">Footer text<input required name="footer_text" value="<%= siteSettings.footer_text %>"></label></div></section><button class="btn primary">Save site settings ↗</button></form><%- include('../partials/admin-bottom') %>
